--# SILENT AIM (update to use toggled values)
if not getgenv().HermesSilentAim then
getgenv().HermesSilentAim = true
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local function getClosestPlayer()
    if not getgenv().SilentAim_ON then return nil end
    local closest, dist, target = nil, getgenv().SilentAim_FOV or 1000, nil
    local mouse = UIS:GetMouseLocation()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild(getgenv().SilentAim_Target) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health>0 then
            local part = p.Character[getgenv().SilentAim_Target]
            local scr, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local d = (Vector2.new(scr.X,scr.Y)-mouse).Magnitude
                if d<dist then closest,dist,target=p,d,part end
            end
        end
    end
    return target
end

local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt,false)
mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if getgenv().SilentAim_ON and method == "FireServer" and tostring(self):lower():find("hit") then
        local t=getClosestPlayer()
        if t then
            args[2]=t.Position
            return old(self, unpack(args))
        end
    end
    return old(self, ...)
end)
setreadonly(mt,true)
end

--# ANTI AIM (live, efficient)
if not getgenv().HermesAntiAim then
getgenv().HermesAntiAim = true
local RunService = game:GetService("RunService")
local lp = game:GetService("Players").LocalPlayer
local PARTS = {"Head","UpperTorso","HumanoidRootPart"}
spawn(function()
    while true do
        RunService.RenderStepped:Wait()
        if getgenv().AntiAim_ON then
            local c = lp.Character or lp.CharacterAdded:Wait()
            for _,pn in ipairs(PARTS) do
                local p = c:FindFirstChild(pn)
                if p and p:IsA("BasePart") then
                    local st = getgenv().AntiAim_Strength or 7
                    local spn = (tick() * (getgenv().AntiAim_Spin or 2.5)) % 360
                    p.CFrame = p.CFrame
                        * CFrame.Angles(math.rad(math.random(-st,st)), math.rad(spn), math.rad(math.random(-st,st)))
                        + Vector3.new(math.random(-st,st)/11, math.random(-st,st)/8, math.random(-st,st)/11)
                end
            end
        end
    end
end)
end

